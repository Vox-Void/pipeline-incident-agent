{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Payment snapshot version 2",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "payment_id",
    "merchant_id",
    "revision",
    "occurred_at",
    "payment_date",
    "status",
    "currency",
    "amount"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "pattern": "^P[0-9]{3,8}:[1-9][0-9]*$(?![\\s\\S])"
    },
    "payment_id": {
      "type": "string",
      "pattern": "^P[0-9]{3,8}$(?![\\s\\S])"
    },
    "merchant_id": {
      "type": "string",
      "pattern": "^M[0-9]{1,8}$(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "payment_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "CAPTURED",
        "REFUNDED"
      ]
    },
    "currency": {
      "const": "ZAR"
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$(?![\\s\\S])"
    },
    "channel": {
      "enum": [
        "WEB",
        "APP"
      ]
    }
  }
}
